---
interface Props {
  id: string;
}

const { id } = Astro.props;
---

<div class="erd-toggle">
  <fieldset class="erd-controls">
    <legend class="sr-only">View</legend>
    <label>
      <input type="radio" name={`${id}-view`} value="data" checked />
      <span>Data</span>
    </label>
    <label>
      <input type="radio" name={`${id}-view`} value="model" />
      <span>Model</span>
    </label>
    <label>
      <input type="radio" name={`${id}-view`} value="schema" />
      <span>Schema</span>
    </label>
  </fieldset>
  <section class="erd-pane erd-data" aria-label="Data"><slot name="data" /></section>
  <section class="erd-pane erd-model" aria-label="Model"><slot name="model" /></section>
  <section class="erd-pane erd-schema" aria-label="Schema"><slot name="schema" /></section>
</div>

<style>
  .erd-toggle,
  .erd-pane {
    min-width: 0;
  }
  .erd-controls {
    display: inline-flex;
    gap: 0.25rem;
    min-width: 0;
    margin: 0 0 1rem;
    padding: 0.25rem;
    border: 1px solid var(--rf-border);
    border-radius: 0.5rem;
    background: var(--rf-surface);
  }
  .erd-controls label {
    position: relative;
    cursor: pointer;
  }
  .erd-controls input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
  }
  .erd-controls span {
    display: block;
    padding: 0.4rem 0.8rem;
    border-radius: 0.3rem;
    color: var(--rf-muted);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .erd-controls input:checked + span {
    color: var(--sl-color-text-accent);
    background: var(--rf-card);
    box-shadow: 0 1px 2px var(--rf-border);
  }
  .erd-controls input:focus-visible + span {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 2px;
  }
  .erd-toggle:has(.erd-controls input[value='data']:checked) > .erd-pane:not(.erd-data),
  .erd-toggle:has(.erd-controls input[value='model']:checked) > .erd-pane:not(.erd-model),
  .erd-toggle:has(.erd-controls input[value='schema']:checked) > .erd-pane:not(.erd-schema) {
    display: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
