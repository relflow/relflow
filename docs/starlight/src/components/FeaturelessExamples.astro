---
import cases from '../data/use-cases.json';
import { datasets } from '../data/datasets';
import CasePicker from './CasePicker.astro';
import DataExplorer from './DataExplorer.astro';
import ExampleSelection from './ExampleSelection.astro';
import ModelDiagram from './ModelDiagram.astro';
import ErdToggle from './ErdToggle.astro';

const examples = cases.map((item) => {
  const dataset = datasets.find((dataset) => dataset.id === item.id);
  if (!dataset) throw new Error(`Featureless modeling use case ${item.id} needs a source dataset.`);
  return { ...item, dataset };
});

const choices = examples.map((item) => ({
  id: item.id,
  panel: `featureless-${item.id}`,
  label: item.label,
  summary: item.structure,
}));
---

<section
  class="featureless-examples not-content"
  aria-label="Explore featureless modeling by use case"
  data-use-cases
>
  <ExampleSelection choices={choices} persistent />
  <CasePicker choices={choices} />
  <p class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-case-status></p>
  {
    examples.map((item) => (
      <article
        id={`featureless-${item.id}`}
        class="featureless-example"
        aria-labelledby={`featureless-${item.id}-title`}
        data-case={item.id}
      >
        <h3 id={`featureless-${item.id}-title`}>{item.label}</h3>
        <ErdToggle id={`featureless-${item.id}`}>
          <DataExplorer
            slot="data"
            id={`featureless-${item.id}-data`}
            dataset={item.dataset}
            headingLevel={4}
            showObservation={false}
          />
          <ModelDiagram slot="model" id={`featureless-${item.id}-model`} schema={item.code} />
        </ErdToggle>
      </article>
    ))
  }
</section>

<script>
  import '../concepts/selection';
</script>

<style>
  .featureless-examples {
    min-width: 0;
  }
  .featureless-example {
    min-width: 0;
    margin-block: var(--rf-section-gap);
    scroll-margin-top: 6rem;
  }
  [data-prepared] .featureless-example,
  [data-ready] .featureless-example {
    margin-block: 0;
  }
  [data-ready] .featureless-example[aria-hidden='true'] {
    display: none;
  }
  .featureless-example h3 {
    margin: 0 0 1rem;
    color: var(--rf-ink);
    font-size: 1.12rem;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
