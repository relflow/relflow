---
import { Code } from '@astrojs/starlight/components';
import { stringify } from 'yaml';
import { flowPaths, flowTransitions, type FlowStage } from '../data-flow/types';
import type { CaseId } from '../data/concepts/types';
import DataViews from './DataViews.astro';
import Tree from './Tree.astro';
import ValueTree from './ValueTree.astro';

interface Props {
  caseId: CaseId;
  stage: FlowStage;
  number: number;
}

const { caseId, stage, number } = Astro.props;
const id = `flow-${caseId}-${stage.id}`;
const modeNames = { predict: 'Prediction', train: 'Training' };
const transition = flowTransitions[stage.id];
const code = stage.code || [];
const codeModes = [
  ...new Set(code.flatMap((item) => (item.mode ? [item.mode] : ['predict', 'train']))),
].join(' ');
/* Descriptions are plain text with optional inline `[label](href)` links. */
const description = stage.description
  .split(/\[([^\]]+)\]\(([^)\s]+)\)/)
  .map((text, index, parts) =>
    index % 3 === 1 ? { text, href: parts[index + 1] } : index % 3 === 0 ? { text } : null,
  )
  .filter((part) => part !== null);
const nextLabels = (['predict', 'train'] as const).flatMap((mode) => {
  const path = flowPaths[mode];
  const position = path.indexOf(stage.id);
  if (position < 0) return [];
  return [
    {
      mode,
      label:
        position === path.length - 1
          ? mode === 'train'
            ? 'Next batch'
            : 'Back to data'
          : 'Continue →',
    },
  ];
});
---

<details class="df-stage" id={id} data-flow-stage={stage.id} data-flow-only-mode={stage.mode} open>
  <summary>
    <span class="df-stage-heading">
      <span class="df-eyebrow">Step {number} / 7</span>
      <strong role="heading" aria-level="4">{stage.title}</strong>
      <span class="df-stage-path" data-flow-stage-mode>
        {stage.mode ? `${modeNames[stage.mode]} path` : 'Shared stages'}
      </span>
    </span>
    {stage.optional && <span class="df-badge">Optional</span>}
  </summary>
  <nav
    class="df-stage-controls"
    data-flow-stage-controls
    aria-label={`${stage.title} navigation`}
    hidden
  >
    <button type="button" data-flow-previous disabled={number === 1} aria-label="Previous stage"
      >← Back</button
    >
    <button type="button" data-flow-next>
      {nextLabels.map((next) => <span data-flow-next-mode={next.mode}>{next.label}</span>)}
    </button>
  </nav>
  <div class="df-stage-body">
    <div class="df-handoff" role="group" aria-label="Data at this stage">
      <dl>
        <dt>Arrives as</dt>
        <dd>{transition.input}</dd>
      </dl>
      <span class="df-handoff-arrow" aria-hidden="true">→</span>
      <dl>
        <dt>{stage.id === 'result' ? 'Returns' : 'Passes on as'}</dt>
        <dd>{transition.output}</dd>
      </dl>
    </div>
    <p class="df-description">
      {
        description.map((part) =>
          'href' in part ? <a href={part.href}>{part.text}</a> : part.text,
        )
      }
    </p>
    <div class="df-views">
      {
        stage.views.map((view, index) => (
          <section
            class="df-view"
            data-flow-view-kind={view.kind}
            data-flow-view-mode={view.mode}
            aria-labelledby={`${id}-view-${index}-title`}
          >
            {view.kind !== 'records' && <h5 id={`${id}-view-${index}-title`}>{view.label}</h5>}
            {view.kind === 'dataset' ? (
              <DataViews
                id={`${id}-view-${index}`}
                dataset={view.dataset}
                schema={view.schema}
                headingLevel={6}
              />
            ) : view.kind === 'records' ? (
              <details class="df-records">
                <summary id={`${id}-view-${index}-title`}>{view.label}</summary>
                <Code
                  code={stringify(view.value, { indent: 2, lineWidth: 0 })}
                  lang="yaml"
                  wrap
                  preserveIndent={false}
                  hangingIndent={2}
                />
              </details>
            ) : view.kind === 'tree' ? (
              <Tree label={view.label} nodes={view.nodes} />
            ) : view.kind === 'prediction' ? (
              <ValueTree
                id={`${id}-view-${index}`}
                value={view.value}
                inputs={view.inputs}
                predictions
                label={view.label}
              />
            ) : (
              <p>{view.text}</p>
            )}
          </section>
        ))
      }
    </div>
    {
      stage.id === 'update' && (
        <p class="df-loop">↳ The next batch follows the same path with the updated model.</p>
      )
    }
    {stage.note && <p class="df-note">{stage.note}</p>}
    {
      code.length > 0 && (
        <details class="df-code" data-flow-code-modes={codeModes}>
          <summary>Code and configuration</summary>
          {code.map((item, index) => (
            <section data-flow-view-mode={item.mode} aria-labelledby={`${id}-code-${index}-title`}>
              <h5 id={`${id}-code-${index}-title`}>
                {item.mode && <span class="df-view-mode">{modeNames[item.mode]} · </span>}
                {item.label}
              </h5>
              <Code code={item.source} lang="python" />
            </section>
          ))}
        </details>
      )
    }
  </div>
</details>
