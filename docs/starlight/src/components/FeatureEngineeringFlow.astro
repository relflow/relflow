---
interface Props {
  id?: string;
}

const { id = 'feature-flow' } = Astro.props;
const traditional = [
  { title: 'Feature engineering' },
  { title: 'HPO', detail: 'Hyperparameter optimization' },
  { title: 'Feature selection' },
  { title: 'Model validation' },
];
---

<figure
  class="feature-flow not-content"
  id={id}
  aria-label="Traditional ML, in-context learning, and relflow workflows"
>
  <div
    class="ff-scroll"
    tabindex="0"
    role="region"
    aria-label="Horizontal modeling workflows; scroll to follow the steps"
  >
    <div class="ff-canvas">
      <section class="ff-workflow" aria-labelledby={`${id}-traditional`}>
        <h3 id={`${id}-traditional`}>Traditional ML &amp; ICL</h3>
        <div class="ff-traditional-route">
          <div class="ff-iteration">
            <ol class="ff-steps">
              {
                traditional.map((step) => (
                  <li class="ff-node">
                    <strong>{step.title}</strong>
                    {step.detail && <p>{step.detail}</p>}
                  </li>
                ))
              }
            </ol>
            <svg
              class="ff-return"
              viewBox="0 0 100 28"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d="M88 1V12Q88 20 80 20H20Q12 20 12 12V1M9 5L12 1L15 5"></path>
            </svg>
            <p class="ff-feedback">Iterate: engineer, tune, select, validate</p>
          </div>
          <span class="ff-route-arrow" aria-hidden="true">→</span>
          <div class="ff-node ff-deployment">
            <strong>Real-time deployment</strong>
            <p>
              Engineer and validate infrastructure to mirror feature engineering, where possible.
            </p>
          </div>
        </div>
      </section>
      <section class="ff-workflow ff-relflow" aria-labelledby={`${id}-relflow`}>
        <h3 id={`${id}-relflow`}>relflow</h3>
        <ol class="ff-steps">
          <li class="ff-node">
            <strong>Declare the model schema</strong>
            <p>Choose what data to include and what to predict.</p>
          </li>
          <li class="ff-node">
            <strong>Train the model</strong>
          </li>
        </ol>
      </section>
    </div>
  </div>
</figure>

<style>
  .feature-flow {
    margin: var(--rf-section-gap) 0;
    min-width: 0;
    color: var(--rf-ink);
    scroll-margin-top: 6rem;
  }
  .ff-scroll {
    max-width: 100%;
    overflow-x: auto;
    border: 1px solid var(--rf-border);
    border-radius: 0.5rem;
    background: var(--rf-card);
    scrollbar-width: thin;
  }
  .ff-scroll:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: 3px;
  }
  .ff-canvas {
    min-width: 46rem;
  }
  .ff-workflow {
    padding: var(--rf-panel-padding);
  }
  .ff-workflow + .ff-workflow {
    border-top: 1px solid var(--rf-border);
  }
  .ff-workflow h3 {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    font-weight: 650;
    line-height: 1.45;
    letter-spacing: -0.02em;
  }
  .ff-traditional-route {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem 9rem;
    align-items: start;
  }
  .ff-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ff-node {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    min-height: 6rem;
    padding: 0.75rem;
    border: 1px solid var(--rf-border);
    border-radius: 0.35rem;
    background: var(--sl-color-bg);
  }
  .ff-steps .ff-node:not(:last-child)::after {
    content: '→';
    position: absolute;
    top: 50%;
    right: -1.5rem;
    width: 1.5rem;
    transform: translateY(-50%);
    color: var(--rf-muted);
    font-size: 1rem;
    line-height: 1.5;
    text-align: center;
  }
  .ff-node > strong {
    font-size: 0.8rem;
    line-height: 1.45;
  }
  .ff-node p {
    margin: 0.4rem 0 0;
    color: var(--rf-muted);
    font-size: 0.73rem;
    line-height: 1.55;
  }
  .ff-return {
    display: block;
    width: 100%;
    height: 2rem;
    overflow: visible;
    fill: none;
    stroke: var(--rf-muted);
    stroke-width: 1.25;
  }
  .ff-return path {
    vector-effect: non-scaling-stroke;
  }
  .ff-feedback {
    margin: 0;
    color: var(--rf-muted);
    font-size: 0.73rem;
    line-height: 1.55;
    text-align: center;
  }
  .ff-route-arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 6rem;
    color: var(--rf-muted);
    font-size: 1rem;
  }
  .ff-deployment {
    border-style: dashed;
  }
  .ff-relflow h3 {
    color: var(--sl-color-text-accent);
  }
  .ff-relflow .ff-steps {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .ff-relflow .ff-node {
    border-color: var(--sl-color-text-accent);
  }
</style>
