    "@expressive-code/core": "0.44.3",
    "@playwright/test": "1.65.0",
    "es-module-lexer": "1.7.0",
    "parse5": "8.1.1",
    "prettier": "3.10.1",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "6.0.3"
